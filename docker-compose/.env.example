# ─── Paths ────────────────────────────────────────────────────────────────────
BASE_PATH=/srv/dev-disk-by-uuid-b4a86245-2d95-433f-9294-2551b5080f83/data
APPDATA_PATH=${BASE_PATH}/docker/appdata
SCRIPTS_PATH=${BASE_PATH}/Scripts/whatsapp-transcription
COMPOSE_PATH=${BASE_PATH}/docker/compose/whatsapp-transcription

# ─── Domain ───────────────────────────────────────────────────────────────────
DOMAIN=09012000.xyz
EVOLUTION_DOMAIN=evolution.09012000.xyz
TRANSCRIPTION_DOMAIN=transcription.09012000.xyz
METABASE_DOMAIN=admin.09012000.xyz

# ─── Evolution API ────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
EVOLUTION_API_KEY=CHANGE_ME_openssl_rand_hex_32

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=transcription
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# ─── Whisper Model ────────────────────────────────────────────────────────────
# Options: medium (default), small, ivrit-ai/whisper-large-v3 (slower)
WHISPER_MODEL=medium
WHISPER_COMPUTE_TYPE=int8
# Number of CPU threads for Whisper (should be <= available cores - 1)
WHISPER_THREADS=3
