# ─── Paths ────────────────────────────────────────────────────────────────────
BASE_PATH=/srv/dev-disk-by-uuid-b4a86245-2d95-433f-9294-2551b5080f83/data
APPDATA_PATH=${BASE_PATH}/docker/appdata
SCRIPTS_PATH=${BASE_PATH}/Scripts/whatsapp-transcription
COMPOSE_PATH=${BASE_PATH}/docker/compose/whatsapp-transcription

# ─── Domains ──────────────────────────────────────────────────────────────────
DOMAIN=09012000.xyz
EVOLUTION_DOMAIN=evolution.09012000.xyz
TRANSCRIPTION_DOMAIN=transcription.09012000.xyz
METABASE_DOMAIN=admin.09012000.xyz

# ─── Evolution API ────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
EVOLUTION_API_KEY=CHANGE_ME

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=transcription
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME

# ─── Encryption (sender_id storage) ──────────────────────────────────────────
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME

# ─── Whisper Model ────────────────────────────────────────────────────────────
# medium = default (769MB RAM, 13-20s per minute of audio, good Hebrew)
# ivrit-ai/whisper-large-v3 = best Hebrew accuracy but 45-90s per minute — home server risk
WHISPER_MODEL=medium
WHISPER_COMPUTE_TYPE=int8
WHISPER_THREADS=3

# Worker memory: 1500m for medium, 3g for large-v3
WORKER_MEM_LIMIT=1500m

# ─── Audio Retention ──────────────────────────────────────────────────────────
# How long to keep original audio files before auto-deletion
AUDIO_RETENTION_DAYS=30

# ─── Language Cache ───────────────────────────────────────────────────────────
# Days to remember a user's dominant language (language doesn't change often)
LANG_CACHE_TTL_DAYS=60

# ─── Rate Limiting ────────────────────────────────────────────────────────────
MAX_AUDIO_MINUTES_PER_DAY=120
MAX_QUEUE_PER_USER=5
COOLDOWN_SECONDS=3
MAX_SINGLE_AUDIO_MINUTES=10

# ─── Logging ──────────────────────────────────────────────────────────────────
# INFO for production, DEBUG for troubleshooting
LOG_LEVEL=INFO
