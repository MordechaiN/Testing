{
  "name": "WhatsApp Voice Transcription",
  "_comment": [
    "WhatsApp client: go-whatsapp-web-multidevice (wa_llm_whatsapp container, port 3000)",
    "Change WHATSAPP_WEBHOOK in your wa_llm docker-compose to: http://n8n:5678/webhook/whatsapp",
    "n8n must be on wa_llm_net. n8n env var: WA_BASIC_AUTH = MordechaiN:YOUR_PASSWORD (base64 for Authorization header)",
    "",
    "go-whatsapp send text API:",
    "  POST http://whatsapp:3000/app/send/message/text",
    "  Header: Authorization: Basic <base64(user:pass)>",
    "  Body: { \"phone\": \"972501234567\", \"message\": \"text\" }",
    "",
    "go-whatsapp download media API (for audio in webhook):",
    "  POST http://whatsapp:3000/app/download-media  (check your version docs)",
    "  OR the webhook payload may already contain base64 audio data.",
    "  Print the first received webhook to check the exact payload format."
  ],
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-whatsapp",
      "name": "Webhook: WhatsApp",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\": true}"
      },
      "id": "respond-immediately",
      "name": "Respond 200 immediately",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [460, 160],
      "_comment": "Always respond 200 immediately — go-whatsapp expects fast ack"
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true},
          "conditions": [
            {
              "leftValue": "={{ $json.body.MessageType ?? $json.body.type ?? '' }}",
              "rightValue": "audio",
              "operator": {"type": "string", "operation": "contains"}
            }
          ]
        }
      },
      "id": "filter-audio",
      "name": "Is Audio Message?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 360],
      "_comment": "go-whatsapp webhook payload: check actual field names by printing first received webhook"
    },
    {
      "parameters": {
        "url": "=http://wa_llm:5001/webhook",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Content-Type", "value": "application/json"}
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {"timeout": 5000, "response": {"response": {"neverError": true}}}
      },
      "id": "forward-to-wa-llm",
      "name": "Forward to wa_llm",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 500],
      "_comment": "Non-audio messages go to wa_llm as before. Timeout short — fire and forget."
    },
    {
      "parameters": {
        "url": "=http://whatsapp:3000/app/download-media",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Basic {{ Buffer.from($env.WA_BASIC_AUTH).toString('base64') }}"
            },
            {"name": "Content-Type", "value": "application/json"}
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: $json.body }) }}",
        "options": {"timeout": 15000}
      },
      "id": "download-audio",
      "name": "Download Audio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "_comment": "Downloads audio from go-whatsapp. Adjust body based on actual webhook payload format."
    },
    {
      "parameters": {
        "url": "http://transcription-api:8000/transcribe",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "audio",
              "value": "={{ $json.data ?? $json.base64 }}",
              "parameterType": "formBinaryData"
            },
            {
              "name": "sender_id",
              "value": "={{ $('Webhook: WhatsApp').item.json.body.Sender ?? $('Webhook: WhatsApp').item.json.body.from ?? 'unknown' }}"
            },
            {
              "name": "message_id",
              "value": "={{ $('Webhook: WhatsApp').item.json.body.MessageID ?? $('Webhook: WhatsApp').item.json.body.id ?? '' }}"
            },
            {
              "name": "callback_url",
              "value": "http://n8n:5678/webhook/transcription-callback"
            },
            {
              "name": "language",
              "value": "auto"
            }
          ]
        },
        "options": {"timeout": 10000}
      },
      "id": "submit-transcription",
      "name": "Submit for Transcription",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "transcription-callback",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-callback",
      "name": "Webhook: Transcription Callback",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 620]
    },
    {
      "parameters": {
        "url": "http://whatsapp:3000/app/send/message/text",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Basic {{ Buffer.from($env.WA_BASIC_AUTH).toString('base64') }}"
            },
            {"name": "Content-Type", "value": "application/json"}
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ phone: $json.body.sender_id, message: '📝 *תמלול:*\\n\\n' + $json.body.text }) }}",
        "options": {}
      },
      "id": "send-reply",
      "name": "Send Reply via WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 620]
    }
  ],
  "connections": {
    "Webhook: WhatsApp": {
      "main": [
        [
          {"node": "Respond 200 immediately", "type": "main", "index": 0},
          {"node": "Is Audio Message?", "type": "main", "index": 0}
        ]
      ]
    },
    "Is Audio Message?": {
      "main": [
        [{"node": "Download Audio", "type": "main", "index": 0}],
        [{"node": "Forward to wa_llm", "type": "main", "index": 0}]
      ]
    },
    "Download Audio": {
      "main": [[{"node": "Submit for Transcription", "type": "main", "index": 0}]]
    },
    "Webhook: Transcription Callback": {
      "main": [[{"node": "Send Reply via WhatsApp", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "tags": ["whatsapp", "transcription"]
}
